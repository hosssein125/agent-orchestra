#!/usr/bin/env bash
# open-pr.sh — the "task → merged PR closes the loop" step (agent-orchestrator
# pattern): when a role replies STATUS: done with a BRANCH, open a PR in that
# role's repo. Requires the GitHub CLI (gh) authenticated with push access.
#
# Enable: rename to open-pr.sh. Optional env/files:
#   ORCH_PR_BASE   base branch for PRs (default: repo default branch)
#   hooks/pr-base  one-line file with the base branch (per-workspace)
cfg_base=""
bf="$(dirname "$(dirname "$0")")/pr-base"
[[ -f "$bf" ]] && cfg_base="$(head -n1 "$bf" | tr -d '[:space:]')"
base="${ORCH_PR_BASE:-$cfg_base}"
base_arg=(); [[ -n "$base" ]] && base_arg=(--base "$base")

command -v gh >/dev/null 2>&1 || exit 0   # gh not installed — stay silent
[[ "${ORCH_EVENT:-reply}" == "reply" ]] || exit 0
[[ -n "${ORCH_REPO:-}" && -n "${ORCH_REPLY_FILE:-}" ]] || exit 0

# only act on STATUS: done + a real branch
status="$(grep -m1 '^STATUS:' "$ORCH_REPLY_FILE" | cut -d: -f2- | tr -d ' ')"
branch="$(grep -m1 '^BRANCH:' "$ORCH_REPLY_FILE" | cut -d: -f2- | tr -d ' ')"
[[ "$status" == "done" && -n "$branch" && "$branch" != "-" ]] || exit 0
git -C "$ORCH_REPO" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null || exit 0

# already has a PR? (gh exits non-zero when none exists)
gh pr view --repo "$(git -C "$ORCH_REPO" remote get-url origin 2>/dev/null)" "$branch" >/dev/null 2>&1 && exit 0

subject="$(grep -m1 '^CHANGED:' "$ORCH_REPLY_FILE" | cut -d: -f2- | sed 's/^ *//')"
gh pr create --repo "$(basename "$(dirname "$ORCH_REPO")")/$(basename "$ORCH_REPO")" \
  --head "$branch" "${base_arg[@]}" \
  --title "${branch#*/}: ${subject:-orchestrated change}" \
  --body "Opened automatically by the orchestration (role ${ORCH_ROLE}, relay $(basename "${ORCH_OUT_FILE:-}")). See the coordination ledger for the full task history." \
  >/dev/null 2>&1 || true
